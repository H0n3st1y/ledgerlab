{
  "name": "ledgerlab",
  "version": "0.1.0",
  "private": true,
  "description": "Payment reliability sandbox: idempotency, double-entry ledger, row locking, transactional outbox, signed webhooks, failure injection.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "tsx src/worker-main.ts",
    "consumer": "tsx src/consumer/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:concurrency": "vitest run --project concurrency",
    "test:invariants": "vitest run --project invariants",
    "test:all": "vitest run",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
