# Postgres started by `docker compose up -d`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerlab
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/ledgerlab_test
PORT=3000
LOG_LEVEL=info
# Run the webhook worker inside the API process (convenient for `npm run dev`)
RUN_WORKER=true
WORKER_POLL_INTERVAL_MS=250
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE_MS=1000
WEBHOOK_BACKOFF_MAX_MS=300000
WEBHOOK_HTTP_TIMEOUT_MS=5000
WEBHOOK_LEASE_MS=30000
# Exposes /dev/* failure-injection endpoints and the dashboard. Never enable in production.
ENABLE_DEV_TOOLS=true
